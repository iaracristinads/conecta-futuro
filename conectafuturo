**`js/router.js`**

```javascript
import {
    templateInicio,
    templateProjetos,
    templateVoluntariado,
    templateContato
} from "./templates.js";

import { iniciarFormularioVoluntario } from "./forms.js";
import { fecharMenu } from "./ui.js";

const routes = {
    inicio: templateInicio,
    projetos: templateProjetos,
    voluntariado: templateVoluntariado,
    contato: templateContato
};

function navegar(rota) {
    const app = document.querySelector("#app");
    const template = routes[rota] || routes.inicio;

    app.innerHTML = template();

    if (rota === "voluntariado") {
        iniciarFormularioVoluntario();
    }

    fecharMenu();
    app.focus();
}

export function iniciarRouter() {
    document.addEventListener("click", (event) => {
        const link = event.target.closest("[data-route]");

        if (!link) return;

        event.preventDefault();

        const rota = link.dataset.route;
        window.location.hash = rota;
    });

    window.addEventListener("hashchange", () => {
        const rota =
            window.location.hash.replace("#", "") || "inicio";

        navegar(rota);
    });

    navegar(
        window.location.hash.replace("#", "") || "inicio"
    );
}
```

