**`js/storage.js`**

```javascript
const CHAVE = "voluntarios";

export function carregarVoluntarios() {
    try {
        return JSON.parse(localStorage.getItem(CHAVE)) || [];
    } catch {
        return [];
    }
}

export function salvarVoluntario(voluntario) {
    const voluntarios = carregarVoluntarios();

    voluntarios.push(voluntario);

    localStorage.setItem(
        CHAVE,
        JSON.stringify(voluntarios)
    );
}
```

**`js/forms.js`**

```javascript
import { salvarVoluntario } from "./storage.js";
import { mostrarToast } from "./ui.js";

function atualizarEstado(campo) {
    const mensagem =
        campo.parentElement.querySelector(".mensagem-erro");

    if (campo.checkValidity()) {
        campo.classList.remove("is-invalid");
        campo.classList.add("is-valid");
        campo.setAttribute("aria-invalid", "false");

        if (mensagem) mensagem.textContent = "";

        return true;
    }

    campo.classList.remove("is-valid");
    campo.classList.add("is-invalid");
    campo.setAttribute("aria-invalid", "true");

    if (mensagem) {
        mensagem.textContent =
            "Verifique o preenchimento deste campo.";
    }

    return false;
}

export function iniciarFormularioVoluntario() {
    const form =
        document.querySelector("#form-voluntario");

    if (!form) return;

    const campos =
        [...form.querySelectorAll(
            "input[required], select[required]"
        )];

    campos.forEach(campo => {
        campo.addEventListener("input", () => {
            atualizarEstado(campo);
        });

        campo.addEventListener("change", () => {
            atualizarEstado(campo);
        });
    });

    form.addEventListener("submit", event => {
        event.preventDefault();

        const valido =
            campos.every(atualizarEstado);

        if (!valido) {
            mostrarToast(
                "Verifique os campos do formulário."
            );
            return;
        }

        salvarVoluntario({
            nome: form.nome.value.trim(),
            email: form.email.value.trim(),
            telefone: form.telefone.value.trim(),
            interesse: form.interesse.value
        });

        form.reset();

        campos.forEach(campo => {
            campo.classList.remove(
                "is-valid",
                "is-invalid"
            );

            campo.removeAttribute("aria-invalid");
        });

        mostrarToast(
            "Cadastro realizado com sucesso!"
        );
    });
}
```

**`js/ui.js`**

```javascript
export function fecharMenu() {
    const menu =
        document.querySelector(".nav-menu");

    const botao =
        document.querySelector("#menu-toggle");

    if (!menu || !botao) return;

    menu.classList.remove("active");
    botao.setAttribute("aria-expanded", "false");
}

export function mostrarToast(mensagem) {
    const toast =
        document.querySelector("#toast");

    if (!toast) return;

    toast.textContent = mensagem;
    toast.classList.add("active");

    setTimeout(() => {
        toast.classList.remove("active");
    }, 3000);
}

export function iniciarInterface() {
    const botaoMenu =
        document.querySelector("#menu-toggle");

    const menu =
        document.querySelector(".nav-menu");

    const contraste =
        document.querySelector("#contraste");

    botaoMenu?.addEventListener("click", () => {
        const aberto =
            menu.classList.toggle("active");

        botaoMenu.setAttribute(
            "aria-expanded",
            String(aberto)
        );
    });

    contraste?.addEventListener("click", () => {
        document.body.classList.toggle(
            "alto-contraste"
        );
    });
}
```

